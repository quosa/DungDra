{
  "permissions": {
    "allow": [
      "Read", "Grep", "Glob",
      "Bash(python3 scripts/audit/audit.py:*)",
      "Bash(scripts/audit/run.sh:*)",
      "Bash(git ls-files:*)", "Bash(git log:*)", "Bash(git diff:*)",
      "Write(.audit/**)"
    ],
    "deny": [
      "Bash(git push:*)", "Bash(git commit:*)", "Bash(rm:*)",
      "Bash(curl:*)", "Bash(wget:*)",
      "Read(./.env*)", "Read(**/secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-writes.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-gate.sh" }] }
    ]
  }
}
